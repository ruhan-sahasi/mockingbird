# Copy to .env and fill in. Never commit .env.
# A line left as `NAME=` counts as unset, and the server refuses to start without
# the required ones.

# Required
ANTHROPIC_API_KEY=
VAPI_API_KEY=
# Where Vapi and browsers reach this server, e.g. an ngrok or CloudFront URL.
# scripts/dev.sh sets it to its ngrok address, so leave it empty when you use dev.sh.
PUBLIC_BASE_URL=
# Random strings. Generate each with: openssl rand -hex 32
BRAIN_SECRET=
WEBHOOK_SECRET=
OWNER_KEY=
VISITOR_SALT=

# Optional. Without DATABASE_URL there is no database to check.
# Supabase session-pooler connection string:
DATABASE_URL=
# Minutes of demo calls allowed per day, across all visitors.
DAILY_DEMO_MINUTES=60
# Call length caps in seconds: demo mode and full mode.
DEMO_CAP_S=300
FULL_CAP_S=1200

# Recordings. With both Supabase values set, WAVs go to a private Storage bucket that the
# server creates on start. Otherwise they go to a local folder (RECORDINGS_DIR, git-ignored).
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# A Supabase secret key (sb_secret_...) or the legacy service_role key, from the project
# settings. A secret: server only, never the browser.
SUPABASE_SERVICE_KEY=
# Optional names. Defaults: bucket "recordings", local folder "recordings".
RECORDINGS_BUCKET=
RECORDINGS_DIR=
